# D3 Dynamic — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). `.env.local` is gitignored.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Used for admin writes & uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Contact-form email notifications (optional). If RESEND_API_KEY is unset,
# submissions are still stored in the DB and email is simply skipped.
RESEND_API_KEY=
CONTACT_NOTIFY_FROM="D3 Website <noreply@d3dynamic.com>"
CONTACT_NOTIFY_TO=info@d3dynamic.com

# Cloudflare R2 object storage (optional). When ALL five are set, admin uploads
# (catalogues, thumbnails, blog, media) go to R2 instead of Supabase Storage —
# zero egress fees. Leave blank to keep using Supabase.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=   # e.g. https://pub-xxxx.r2.dev  OR  https://cdn.d3dynamic.com
